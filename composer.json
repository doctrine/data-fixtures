{
    "name": "doctrine/data-fixtures",
    "type": "library",
    "description": "Data Fixtures for all Doctrine Object Managers",
    "keywords": [
        "database"
    ],
    "homepage": "https://www.doctrine-project.org",
    "license": "MIT",
    "authors": [
        {
            "name": "Jonathan Wage",
            "email": "jonwage@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "doctrine/persistence": "^4",
        "psr/log": "^1.1 || ^2 || ^3"
    },
    "conflict": {
        "doctrine/dbal": "<4.5 || >=5",
        "doctrine/orm": "<3.7 || >=4",
        "doctrine/mongodb-odm": "<2.17",
        "doctrine/phpcr-odm": "<3"
    },
    "require-dev": {
        "ext-sqlite3": "*",
        "doctrine/coding-standard": "^14",
        "doctrine/dbal": "^4.5",
        "doctrine/mongodb-odm": "^2.17",
        "doctrine/orm": "^3.7",
        "doctrine/phpcr-odm": "^3.0",
        "jackalope/jackalope": "^2",
        "jackalope/jackalope-doctrine-dbal": "^2",
        "fig/log-test": "^1",
        "phpstan/phpstan": "2.3.5",
        "phpunit/phpunit": "13.4.6",
        "symfony/cache": "^8.1"
    },
    "suggest": {
        "doctrine/mongodb-odm": "For loading MongoDB ODM fixtures",
        "doctrine/orm": "For loading ORM fixtures",
        "doctrine/phpcr-odm": "For loading PHPCR ODM fixtures"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "autoload": {
        "psr-4": {
            "Doctrine\\Common\\DataFixtures\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Doctrine\\Tests\\": "tests"
        }
    }
}
